# Variáveis do docker-compose.yml. Copie para ".env" (na raiz do projeto) e ajuste.
# Este arquivo é usado só pelo Docker; para rodar sem Docker, use backend/.env.

# Banco de dados criado pelo container do PostgreSQL.
# Evite os caracteres @ : / # % na senha: ela vai dentro da URL de conexão.
POSTGRES_USER=pdv
POSTGRES_PASSWORD=pdv
POSTGRES_DB=pdv

# Chave que assina os tokens JWT (obrigatória). Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-e-longa
