# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# O arquivo .env NÃO vai para o Git (está no .gitignore).

# URL de conexão com o PostgreSQL
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pdv

# Autenticação JWT
# Chave usada para assinar os tokens. Gere uma chave própria com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-e-longa
# Tempo de validade do token (480 min = 8 horas, um turno de caixa)
JWT_EXPIRA_MINUTOS=480

# Fuso horário usado nos filtros por data (opcional; este é o padrão)
FUSO_HORARIO=America/Sao_Paulo

# Pasta onde ficam as fotos enviadas (opcional; padrão: backend/uploads, fora do Git)
# UPLOADS_DIR=C:/pdv/uploads

# Endereços do frontend autorizados a chamar a API (CORS), em formato JSON (opcional)
CORS_ORIGENS=["http://localhost:5173"]

# Banco usado pelo pytest (opcional). Se não for definido, os testes usam o mesmo
# servidor do DATABASE_URL com o banco "pdv_test". ATENÇÃO: os testes apagam os dados dele.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pdv_test
